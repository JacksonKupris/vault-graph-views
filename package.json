{
  "name": "vault-graph-views",
  "version": "0.14.0",
  "private": true,
  "description": "The graphs for Vault Graph: one renderer and every graph, loaded by the Obsidian plugin or run on a standalone page.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./contract": "./src/contract.js",
    "./bundle": "./dist/vault-graph-views.js",
